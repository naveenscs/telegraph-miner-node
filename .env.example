GROQ_API_KEY=gsk_your_actual_api_key_here
# Optional extras for rotation: GROQ_API_KEY_2 ... GROQ_API_KEY_5 or GROQ_API_KEYS=k1,k2
SSL_VERIFY=true
GROQ_TIMEOUT=60.0
GROQ_MODEL=openai/gpt-oss-20b

# Infer forecast / explain / howto / default from the question (default on).
# Prompts are GT-match-first (WASM ~50% cosine vs ground truth).
ADAPTIVE_STYLE=true
# Used only when ADAPTIVE_STYLE=false:
SHORT_ANSWERS=true

# Token ladder: start at 512, escalate on empty / finish_reason=length
TOKEN_LADDER=512,768,1024

# Optional prompt overrides:
# PROMPT_FORECAST=...
# PROMPT_EXPLAIN=...
# PROMPT_HOWTO=...
# PROMPT_DEFAULT=...  # mild GT-match when style is unsure
# SYSTEM_PROMPT=...   # legacy when ADAPTIVE_STYLE=false
