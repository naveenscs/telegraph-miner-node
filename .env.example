GROQ_API_KEY=gsk_your_actual_api_key_here
# Optional extras for rotation: GROQ_API_KEY_2 ... GROQ_API_KEY_5 or GROQ_API_KEYS=k1,k2
SSL_VERIFY=true
GROQ_TIMEOUT=60.0
GROQ_MODEL=openai/gpt-oss-20b

# Concise Telegraph-friendly answers (default on). Set SHORT_ANSWERS=false to disable.
SHORT_ANSWERS=true
SHORT_ANSWER_MAX_TOKENS=384
# Optional override of the built-in system prompt:
# SYSTEM_PROMPT=Your custom instructions here
